# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# Two tiers, and the split is load-bearing:
#
#   NEXT_PUBLIC_*  are inlined into the browser bundle by Next at build time.
#                  Only put values here that are safe to publish.
#
#   everything else is server-only. It is read exclusively through
#                  src/lib/env.server.ts, which imports 'server-only' -- so if
#                  any client component ever reaches for one of these, the build
#                  fails instead of shipping the secret.


# --- Public: safe in the browser bundle -------------------------------------
# The anon key is designed to be public. Every table is behind RLS and the
# floor schema additionally requires an active row in floor.staff.
NEXT_PUBLIC_SUPABASE_URL=https://lovfbqnuxdihjidxacet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# --- Server only: must never appear in the client bundle --------------------

# Bypasses RLS entirely. Needed only for the Apps Script ingest path and the
# future on-prem media agent. Leave unset until something actually needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Vista API. JWT auth: POST /token/ with username+password returns access +
# refresh; the access token is cached server-side and refreshed rather than
# re-logging-in. Browsers never talk to this host directly -- CORS forbids it
# and it would expose these credentials.
VISTA_API_BASE_URL=https://api.vistaapp.tech/api/v1
VISTA_API_USERNAME=
VISTA_API_PASSWORD=

# Only if this app ever needs to read the Slack List directly. The Apps Script
# owns the Slack sync, so this normally stays unset.
SLACK_BOT_TOKEN=
